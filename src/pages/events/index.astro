---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a,b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const eventSlug = (event) => event.id || event.slug || event.data.slug || event.data.title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const years = [...new Set(events.map(e => String(new Date(`${e.data.date}T12:00:00`).getFullYear())))];
const dateLabel = d => new Date(`${d}T12:00:00`).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
---
<Base title="Events & Blog | Janata Pratisthan" description="Browse Janata Pratisthan event stories, annual activities, and community updates.">
  <main class="section"><div class="container"><div class="heading"><span class="eyebrow">Our journey, year by year</span><h1 style="font-size:clamp(2.4rem,5vw,4rem);line-height:1.1;letter-spacing:-2px">Events &amp; stories</h1><p>Browse our event archive, revisit important moments, and read the stories behind our community work.</p></div>
    <div class="archive-tools"><input id="search" type="search" placeholder="Search events..." aria-label="Search events" /><select id="year" aria-label="Filter by year"><option value="all">All years</option>{years.map(year => <option value={year}>{year}</option>)}</select><select id="category" aria-label="Filter by category"><option value="all">All categories</option>{[...new Set(events.map(e=>e.data.category))].sort().map(cat=><option value={cat}>{cat}</option>)}</select></div>
    {events.length ? <div class="grid" id="event-grid">{events.map(event => <article class="card event-card" data-title={event.data.title.toLowerCase()} data-year={new Date(`${event.data.date}T12:00:00`).getFullYear()} data-category={event.data.category}><a href={`/events/${eventSlug(event)}/`}>{event.data.cover && <img src={event.data.cover} alt={event.data.title} loading="lazy" />}<div class="card-content"><span class="tag">{event.data.category}</span><h3>{event.data.title}</h3><p>{event.data.excerpt}</p><div class="meta">{dateLabel(event.data.date)}{event.data.location ? ` · ${event.data.location}` : ''}</div><p class="read">Read event story →</p></div></a></article>)}</div> : <div class="empty">No published events yet. Add your first story in the CMS dashboard.</div>}
    <p id="no-results" class="empty" hidden>No events match these filters.</p>
  </div></main>
  <script is:inline>
    const search = document.querySelector('#search'), year = document.querySelector('#year'), category = document.querySelector('#category');
    const cards = [...document.querySelectorAll('.event-card')], empty = document.querySelector('#no-results');
    function filter(){let shown=0;cards.forEach(card=>{const match=card.dataset.title.includes(search.value.toLowerCase())&&(year.value==='all'||card.dataset.year===year.value)&&(category.value==='all'||card.dataset.category===category.value);card.hidden=!match;if(match)shown++;});empty.hidden=shown>0;}
    [search,year,category].forEach(el=>el.addEventListener('input',filter));
  </script>
</Base>
