---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  const eventSlug = (event) => event.id || event.slug || event.data.slug || event.data.title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return events.map(event => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const d = event.data.date;
const dateLabel = new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<Base title={`${event.data.title} | Janata Pratisthan`} description={event.data.excerpt}>
  <main id="main-content" class="section"><article class="container article">
    <a class="article-back" href="/events/"><span aria-hidden="true">←</span> Back to the journal</a>
    <header class="article-head"><p><span class="tag">{event.data.category}</span></p><h1>{event.data.title}</h1><p class="muted">{dateLabel}{event.data.location ? ` · ${event.data.location}` : ''}</p></header>
    {event.data.cover && <img class="article-cover" src={event.data.cover} alt={event.data.title} width="1200" height="800" fetchpriority="high" decoding="async" />}
    <p class="muted" style="font-size:1.2rem;line-height:1.7">{event.data.excerpt}</p>
    <div class="prose"><Content /></div>
    {event.data.gallery?.length > 0 && <><h2 class="section-title" style="font-size:2.4rem;margin-top:48px">A closer look</h2><div class="gallery">{event.data.gallery.map((photo) => <img src={photo} alt={`Photo from ${event.data.title}`} width="600" height="400" loading="lazy" decoding="async" />)}</div></>}
    <div style="border-top:1px solid var(--line);margin-top:55px;padding-top:28px"><a class="btn" href="/events/">Explore more stories <span aria-hidden="true">→</span></a></div>
  </article></main>
</Base>
