---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  const eventSlug = (event) => event.id || event.slug || event.data.slug || event.data.title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return events.map(event => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const d = event.data.date;
const dateLabel = new Date(`${d}T12:00:00`).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'});
---
<Base title={`${event.data.title} | Janata Pratisthan`} description={event.data.excerpt}>
  <main class="section"><article class="container article">
    <a class="read" href="/events/">← All events</a><p style="margin-top:22px"><span class="tag">{event.data.category}</span></p>
    <h1>{event.data.title}</h1><p class="muted">{dateLabel}{event.data.location ? ` · ${event.data.location}` : ''}</p>
    {event.data.cover && <img class="article-cover" src={event.data.cover} alt={event.data.title} />}
    <p class="muted" style="font-size:1.15rem">{event.data.excerpt}</p>
    <div class="prose"><Content /></div>
    {event.data.gallery?.length > 0 && <><h2 style="margin-top:42px">Event gallery</h2><div class="gallery">{event.data.gallery.map((photo) => <img src={photo} alt={`Photo from ${event.data.title}`} loading="lazy" />)}</div></>}
    <p style="margin-top:45px"><a class="btn" href="/events/">Explore more events →</a></p>
  </article></main>
</Base>
