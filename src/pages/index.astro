---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const allEvents = await getCollection('events', ({ data }) => !data.draft);
const events = allEvents.sort((a,b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const featured = events.filter(e => e.data.featured).slice(0,5);
const cards = featured.length ? featured : events.slice(0,5);
const recent = events.slice(0,3);
const eventSlug = (event) => event.id || event.slug || event.data.slug || event.data.title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const dateLabel = d => new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<Base title="Janata Pratisthan | People first. Progress together." description="A closer look at the people, moments, and community initiatives that shape Janata Pratisthan.">
  <main id="main-content">
    <section class="hero">
      <div class="hero-carousel-stage">
        <div class="hero-carousel hero-carousel-wide" aria-label="Janata Pratisthan community photo carousel">
          <div class="hero-slides" id="hero-slides">
            <figure class="hero-slide is-active" data-slide="0" aria-hidden="false"><picture><source srcset="/carousel/1.webp" type="image/webp" /><img class="hero-img" src="/carousel/1.png" width="1600" height="900" alt="Janata Pratisthan community members gathered together" fetchpriority="high" decoding="async" /></picture><figcaption class="image-note">Together, we build stronger communities.</figcaption></figure>
            <figure class="hero-slide" data-slide="1" aria-hidden="true"><picture><source srcset="/carousel/2.webp" type="image/webp" /><img class="hero-img" src="/carousel/2.png" width="1600" height="900" alt="A community teaching and learning gathering" loading="lazy" decoding="async" /></picture><figcaption class="image-note">Knowledge grows when it is shared.</figcaption></figure>
            <figure class="hero-slide" data-slide="2" aria-hidden="true"><picture><source srcset="/carousel/3.webp" type="image/webp" /><img class="hero-img" src="/carousel/3.png" width="1600" height="900" alt="Community members taking part in a diya ceremony" loading="lazy" decoding="async" /></picture><figcaption class="image-note">Tradition, dignity, and shared purpose.</figcaption></figure>
          </div>
          <div class="hero-carousel-controls">
            <button class="hero-arrow" type="button" id="hero-prev" aria-label="Previous photo">←</button>
            <div class="hero-dots" role="group" aria-label="Choose a photo"><button type="button" class="hero-dot is-active" data-go="0" aria-label="Show photo 1" aria-pressed="true"></button><button type="button" class="hero-dot" data-go="1" aria-label="Show photo 2" aria-pressed="false"></button><button type="button" class="hero-dot" data-go="2" aria-label="Show photo 3" aria-pressed="false"></button></div>
            <button class="hero-arrow" type="button" id="hero-next" aria-label="Next photo">→</button>
            <button class="hero-pause" type="button" id="hero-pause" aria-label="Pause automatic slideshow" aria-pressed="false">Ⅱ</button>
          </div>
        </div>
      </div>
      <div class="container hero-copy-below">
        <span class="eyebrow">A community-led journal</span>
        <h1>Progress begins when <span>people come first.</span></h1>
        <p>Every meaningful change starts with people coming together. Explore the stories, events, and shared moments that make up the journey of Janata Pratisthan.</p>
        <div class="actions"><a class="btn" href="#events">Explore the journal <span aria-hidden="true">↘</span></a><a class="btn btn-outline" href="#about">Discover our story</a></div>
        <div class="hero-meta">Community · Stories · Shared progress</div>
      </div>
    </section>
    <section class="section" id="about">
      <div class="container intro-section">
        <div class="intro-label"><span class="eyebrow">The idea behind it all</span></div>
        <div class="intro-copy"><h2>A stronger community is a story we write together.</h2><p>Janata Pratisthan brings people, activities, and community moments into one shared space. This journal is designed to make those moments easier to discover, revisit, and share.</p><a class="text-link" href="/events/">Get to know our work <span aria-hidden="true">→</span></a></div>
      </div>
    </section>
    <section class="section split" id="events">
      <div class="container">
        <div class="section-topline"><div class="heading"><span class="eyebrow">Out in the community</span><h2>Moments that move us forward.</h2><p>Explore the latest highlights and stories from our shared journey.</p></div><div class="carousel-controls" aria-label="Featured story controls"><button type="button" data-dir="-1" aria-label="Previous stories">←</button><button type="button" data-dir="1" aria-label="Next stories">→</button></div></div>
        {cards.length ? <div class="carousel" id="event-carousel">{cards.map(event => <article class="card"><a href={`/events/${eventSlug(event)}/`}><div class="card-image">{event.data.cover ? <img src={event.data.cover} alt={event.data.title} loading="lazy" /> : <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=900&q=80" alt="People gathered together" loading="lazy" />}</div><div class="card-content"><span class="tag">{event.data.category}</span><h3>{event.data.title}</h3><p>{event.data.excerpt}</p><div class="meta">{dateLabel(event.data.date)}</div><p class="read">Read the story <span aria-hidden="true">→</span></p></div></a></article>)}</div> : <div class="empty">Our community stories will appear here soon. Visit again for updates.</div>}
        <p style="margin-top:22px"><a class="text-link" href="/events/">Browse every story <span aria-hidden="true">→</span></a></p>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-topline"><div class="heading"><span class="eyebrow">From the journal</span><h2>Recent stories &amp; updates.</h2><p>Take a closer look at the activities and moments being shared.</p></div><a class="text-link" href="/events/">View all stories <span aria-hidden="true">→</span></a></div>
        {recent.length ? <div class="grid">{recent.map(event => <article class="card"><a href={`/events/${eventSlug(event)}/`}><div class="card-image">{event.data.cover ? <img src={event.data.cover} alt={event.data.title} loading="lazy" /> : <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=900&q=80" alt="People gathered together" loading="lazy" />}</div><div class="card-content"><span class="tag">{event.data.category}</span><h3>{event.data.title}</h3><p>{event.data.excerpt}</p><div class="meta">{dateLabel(event.data.date)}</div><p class="read">Continue reading <span aria-hidden="true">→</span></p></div></a></article>)}</div> : <div class="empty">No published stories just yet. Add your first event through the publishing dashboard.</div>}
      </div>
    </section>
    <section class="impact-band"><div class="container impact-band-inner"><h2>Behind every meaningful change, there are people who care.</h2><p>Real progress is built through shared effort, local knowledge, and the belief that every person can make a difference.</p></div></section>
    <section class="cta" id="support"><div class="container cta-inner"><span class="eyebrow">Make room for change</span><h2>Big change begins with people showing up.</h2><p>Discover the initiatives, community moments, and stories shaping Janata Pratisthan. Your interest is the first step toward being part of the journey.</p><div class="actions cta-actions"><a class="btn btn-yellow" href="/events/">Explore our journal <span aria-hidden="true">↗</span></a><a class="btn cta-outline" href="#events">Discover community stories <span aria-hidden="true">↓</span></a></div><div class="cta-note">People first. Progress together.</div></div></section>
  </main>
  <script is:inline>
    const track = document.querySelector('#event-carousel');
    document.querySelectorAll('[data-dir]').forEach(button => button.addEventListener('click', () => {
      if (track) track.scrollBy({ left: Number(button.dataset.dir) * Math.min(track.clientWidth * .8, 420), behavior: 'smooth' });
    }));

    const heroSlides = [...document.querySelectorAll('.hero-slide')];
    const heroDots = [...document.querySelectorAll('.hero-dot')];
    const heroPrev = document.querySelector('#hero-prev');
    const heroNext = document.querySelector('#hero-next');
    const heroPause = document.querySelector('#hero-pause');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let heroIndex = 0;
    let heroTimer = null;
    let heroPaused = reduceMotion;
    function showHeroSlide(index) {
      heroIndex = (index + heroSlides.length) % heroSlides.length;
      heroSlides.forEach((slide, i) => {
        const active = i === heroIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      heroDots.forEach((dot, i) => {
        const active = i === heroIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-pressed', String(active));
      });
    }
    function stopHeroTimer() { if (heroTimer) window.clearInterval(heroTimer); heroTimer = null; }
    function startHeroTimer() {
      stopHeroTimer();
      if (!heroPaused && heroSlides.length > 1) heroTimer = window.setInterval(() => showHeroSlide(heroIndex + 1), 5500);
      if (heroPause) {
        heroPause.textContent = heroPaused ? '▶' : 'Ⅱ';
        heroPause.setAttribute('aria-label', heroPaused ? 'Resume automatic slideshow' : 'Pause automatic slideshow');
        heroPause.setAttribute('aria-pressed', String(heroPaused));
      }
    }
    heroPrev?.addEventListener('click', () => { showHeroSlide(heroIndex - 1); startHeroTimer(); });
    heroNext?.addEventListener('click', () => { showHeroSlide(heroIndex + 1); startHeroTimer(); });
    heroDots.forEach(dot => dot.addEventListener('click', () => { showHeroSlide(Number(dot.dataset.go)); startHeroTimer(); }));
    heroPause?.addEventListener('click', () => { heroPaused = !heroPaused; startHeroTimer(); });
    document.querySelector('.hero-carousel')?.addEventListener('mouseenter', stopHeroTimer);
    document.querySelector('.hero-carousel')?.addEventListener('mouseleave', startHeroTimer);
    document.querySelector('.hero-carousel')?.addEventListener('focusin', stopHeroTimer);
    document.querySelector('.hero-carousel')?.addEventListener('focusout', startHeroTimer);
    document.addEventListener('visibilitychange', () => document.hidden ? stopHeroTimer() : startHeroTimer());
    showHeroSlide(0);
    startHeroTimer();
  </script>
</Base>
