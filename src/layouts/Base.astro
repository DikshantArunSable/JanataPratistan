---
const { title = 'Janata Pratisthan | People first. Progress together.', description = 'Stories, initiatives, and community moments from Janata Pratisthan.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#2373F4" />
  <link rel="icon" type="image/png" href="/uploads/favicon.png" />
  <link rel="apple-touch-icon" href="/uploads/favicon.png" />
  <meta name="description" content={description} />
  <meta property="og:site_name" content="Janata Pratisthan" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root{color-scheme:light;--blue:#2373F4;--soft:#578EF5;--cyan:#65D0F4;--yellow:#F2F7A0;--ink:#17243A;--muted:#647187;--pale:#F4F8FF;--line:#E5ECF7;--paper:#fff;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Inter,'Segoe UI',Arial,sans-serif;--radius:20px;--shadow:0 22px 65px rgba(23,36,58,.09)}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--paper);font-family:var(--sans);color:var(--ink);line-height:1.72;-webkit-font-smoothing:antialiased}::selection{background:var(--yellow);color:var(--ink)}a{color:inherit;text-decoration:none}img{display:block;max-width:100%;object-fit:cover}button,input,select{font:inherit}.container{width:min(1240px,88%);margin-inline:auto}.section{padding:clamp(64px,8vw,112px) 0}.eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--blue);font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.eyebrow:before{content:'';display:inline-block;width:22px;height:2px;background:currentColor}.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:13px 20px;border:1px solid var(--blue);border-radius:3px;background:var(--blue);color:#fff;font-weight:700;font-size:.9rem;transition:transform .2s,background .2s,border-color .2s}.btn:hover{background:#155bd0;border-color:#155bd0;transform:translateY(-2px)}.btn-yellow{background:var(--yellow);border-color:var(--yellow);color:var(--ink)}.btn-yellow:hover{background:#e6ed85;border-color:#e6ed85;color:var(--ink)}.btn-outline{background:transparent;color:var(--ink);border-color:#cbd5e4}.btn-outline:hover{background:var(--ink);border-color:var(--ink);color:#fff}.navbar{position:sticky;top:0;z-index:30;background:rgba(255,255,255,.94);border-bottom:1px solid rgba(229,236,247,.9);backdrop-filter:blur(18px)}.nav-inner{min-height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;font-weight:800;font-size:1rem;letter-spacing:-.03em}.brand-logo{display:block;width:clamp(170px,20vw,245px);height:auto;max-height:66px;object-fit:contain;object-position:left center}.footer-row .brand-logo{width:min(250px,100%);max-height:88px}.brand-mark{display:grid;place-items:center;width:42px;height:42px;background:var(--blue);color:#fff;font-size:1.35rem;line-height:1}.brand-name{display:flex;flex-direction:column;line-height:1.1}.brand-name small{margin-top:5px;color:var(--muted);font-size:.62rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}.nav-links{display:flex;align-items:center;gap:clamp(14px,2.3vw,30px);font-size:.85rem;font-weight:650}.nav-links>a:not(.btn){position:relative;padding:10px 0}.nav-links>a:not(.btn):after{position:absolute;right:0;bottom:3px;left:0;height:1px;background:var(--blue);content:'';transform:scaleX(0);transform-origin:left;transition:transform .2s}.nav-links>a:not(.btn):hover:after{transform:scaleX(1)}.nav-links .btn{padding:10px 15px}.hero{position:relative;overflow:hidden;padding:0 0 clamp(56px,7vw,96px);background:linear-gradient(180deg,#fff 0%,#f4f8ff 100%)}.hero-carousel-stage{width:100%;padding:0;margin:0;background:#eaf1fc}.hero-carousel-wide{width:100%;max-width:none;margin:0;padding:0;position:relative}.hero-carousel-wide .hero-slides{width:100%}.hero-carousel-wide .hero-slide{width:100%;height:clamp(340px,54vw,690px);max-height:76vh;overflow:hidden;background:#dfe8f5}.hero-carousel-wide .hero-slide .hero-img{display:block;width:100%;height:100%;max-height:none;aspect-ratio:auto;object-fit:contain;object-position:center;background:#eaf1fc;box-shadow:none;border-radius:0}.hero-carousel-wide .hero-slide .image-note{right:clamp(18px,5vw,72px);bottom:clamp(18px,4vw,46px);max-width:min(300px,45%);padding:16px 20px}.hero-carousel-wide .hero-carousel-controls{position:absolute;right:clamp(18px,5vw,72px);bottom:clamp(18px,4vw,46px);margin:0;padding:7px;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.8);box-shadow:0 10px 32px rgba(23,36,58,.13)}.hero-carousel-wide .hero-slide .image-note{bottom:clamp(74px,8vw,98px)}.hero-copy-below{position:relative;z-index:2;width:min(1000px,calc(100% - 40px));max-width:1000px;margin:clamp(30px,4.5vw,58px) auto 0;padding:clamp(28px,5vw,58px) clamp(24px,5vw,64px);border:1px solid rgba(255,255,255,.96);border-radius:28px;background:linear-gradient(135deg,rgba(255,255,255,.88) 0%,rgba(220,235,255,.84) 48%,rgba(218,249,255,.8) 100%);box-shadow:0 28px 80px rgba(35,115,244,.22),0 8px 24px rgba(23,36,58,.1),inset 0 1px 0 rgba(255,255,255,.98);backdrop-filter:blur(28px) saturate(175%);-webkit-backdrop-filter:blur(28px) saturate(175%)}.hero-copy-below:before{position:absolute;top:0;left:clamp(24px,5vw,64px);width:68px;height:3px;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--cyan));content:''}.hero-copy-below .eyebrow{margin-bottom:6px}.hero-copy-below h1{max-width:950px;margin-top:16px}.hero-copy-below p{max-width:720px}.hero-copy-below .hero-meta{margin-top:26px}.hero-copy-below .actions{margin-top:24px}.hero:after{position:absolute;right:-140px;bottom:-280px;width:520px;height:520px;border:1px solid rgba(35,115,244,.12);border-radius:50%;content:'';pointer-events:none}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr .93fr;align-items:center;gap:clamp(36px,6vw,88px)}.hero-copy{max-width:660px}.hero h1,.display-title{font-family:var(--serif);font-weight:600;font-size:clamp(3.1rem,6.3vw,6.25rem);line-height:.99;letter-spacing:-.055em;margin:22px 0 26px}.hero h1 span{color:var(--blue);font-style:italic}.hero p{max-width:550px;color:#536179;font-size:clamp(1rem,1.35vw,1.13rem);line-height:1.85}.hero-img-wrap{position:relative;padding:0 0 30px 30px}.hero-img-wrap:before{position:absolute;left:0;bottom:0;width:70%;height:70%;border-left:2px solid var(--blue);border-bottom:2px solid var(--blue);content:''}.hero-img{position:relative;width:100%;height:clamp(350px,42vw,560px);border-radius:2px;box-shadow:var(--shadow)}.image-note{position:absolute;right:-14px;bottom:0;max-width:210px;padding:18px 20px;background:var(--yellow);font-family:var(--serif);font-size:1.1rem;line-height:1.35;box-shadow:0 12px 30px #17243a14}.hero-carousel{min-width:0}.hero-slides{position:relative;z-index:1}.hero-slide{display:none;position:relative;margin:0;animation:heroFade .55s ease both}.hero-slide.is-active{display:block}.hero-slide .hero-img{object-position:center;aspect-ratio:4/5}.hero-slide .image-note{z-index:2;right:-14px;bottom:0}.hero-carousel-controls{position:relative;z-index:2;display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-top:16px}.hero-arrow,.hero-pause{display:grid;place-items:center;width:38px;height:38px;border:1px solid #d5e0f0;background:#fff;color:var(--ink);cursor:pointer;transition:background .2s,border-color .2s,transform .2s}.hero-arrow:hover,.hero-pause:hover{background:var(--yellow);border-color:var(--yellow);transform:translateY(-1px)}.hero-dots{display:flex;align-items:center;justify-content:center;gap:8px;margin:0 5px}.hero-dot{width:8px;height:8px;padding:0;border:0;border-radius:99px;background:#b8c6dc;cursor:pointer;transition:width .25s,background .25s}.hero-dot.is-active{width:25px;background:var(--blue)}.hero-arrow:focus-visible,.hero-pause:focus-visible,.hero-dot:focus-visible{outline:3px solid var(--soft);outline-offset:3px}@keyframes heroFade{from{opacity:.45;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.hero-meta{display:flex;align-items:center;gap:14px;margin-top:38px;color:var(--muted);font-size:.75rem;letter-spacing:.06em;text-transform:uppercase}.hero-meta:before{width:34px;height:1px;background:var(--blue);content:''}.heading{max-width:740px;margin-bottom:42px}.heading h2,.section-title{font-family:var(--serif);font-size:clamp(2.3rem,4.7vw,4rem);font-weight:600;line-height:1.08;letter-spacing:-.045em;margin:15px 0}.heading p,.muted{color:var(--muted)}.heading p{max-width:650px;font-size:1rem}.section-topline{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:35px}.section-topline .heading{margin:0}.text-link{display:inline-flex;align-items:center;gap:10px;color:var(--blue);font-size:.88rem;font-weight:750;white-space:nowrap}.text-link span{transition:transform .2s}.text-link:hover span{transform:translateX(4px)}.intro-section{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(30px,8vw,120px);align-items:start}.intro-label{padding-top:12px}.intro-copy h2{max-width:800px;font-family:var(--serif);font-size:clamp(2.25rem,4.2vw,3.65rem);font-weight:500;line-height:1.12;letter-spacing:-.04em;margin:0 0 22px}.intro-copy p{max-width:700px;color:var(--muted);font-size:1.05rem}.split{background:var(--pale)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.card{min-width:0;overflow:hidden;border:1px solid var(--line);background:#fff;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.card>a{display:block;height:100%}.card img{width:100%;height:235px;transition:transform .5s}.card:hover img{transform:scale(1.025)}.card-image{overflow:hidden;background:#e8effb}.card-content{padding:24px 24px 26px}.tag{display:inline-flex;color:var(--blue);background:#edf3ff;padding:5px 10px;font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.card h3{font-family:var(--serif);font-size:1.55rem;font-weight:600;line-height:1.2;letter-spacing:-.02em;margin:15px 0 10px}.card p{color:var(--muted);font-size:.91rem;line-height:1.7}.meta{color:#8490a2;font-size:.76rem;letter-spacing:.04em}.read{display:inline-flex;align-items:center;gap:8px;color:var(--blue);font-size:.85rem;font-weight:750}.carousel{display:grid;grid-auto-columns:minmax(300px,36%);grid-auto-flow:column;gap:22px;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:3px 3px 22px;scrollbar-width:thin;scrollbar-color:#c6d6f1 transparent}.carousel .card{height:100%}.carousel .card>a{display:flex;flex-direction:column}.carousel .card-content{display:flex;flex:1;flex-direction:column;align-items:flex-start}.carousel .card-content .read{margin-top:auto;padding-top:8px}.carousel .card{scroll-snap-align:start}.carousel-controls{display:flex;gap:8px}.carousel-controls button{display:grid;place-items:center;width:44px;height:44px;border:1px solid #d7e1f1;background:#fff;cursor:pointer;color:var(--blue);font-size:1.25rem;transition:background .2s}.carousel-controls button:hover{background:var(--yellow)}.impact-band{padding:42px 0;background:var(--ink);color:#fff}.impact-band-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.impact-band h2{max-width:620px;font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,3rem);font-weight:500;line-height:1.15;margin:0}.impact-band p{max-width:440px;color:#c9d4e6;margin:0}.cta{position:relative;overflow:hidden;background:var(--blue);color:#fff;text-align:center;padding:clamp(70px,9vw,118px) 0}.cta:after{position:absolute;top:-190px;right:-100px;width:440px;height:440px;border:1px solid #ffffff30;border-radius:50%;content:''}.cta .container{position:relative;z-index:1}.cta h2{font-family:var(--serif);font-size:clamp(2.5rem,5.6vw,4.7rem);font-weight:500;line-height:1.05;letter-spacing:-.04em;max-width:850px;margin:20px auto}.cta p{max-width:620px;margin:0 auto 28px;color:#eaf2ff}.cta .eyebrow{color:var(--yellow)}.cta-inner{max-width:900px}.cta-actions{justify-content:center;margin-top:30px}.cta .cta-outline{background:transparent;border-color:#ffffff90;color:#fff}.cta .cta-outline:hover{background:#fff;color:var(--ink);border-color:#fff}.cta-note{margin-top:28px;color:#ffffffb8;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase}.cta-note:before,.cta-note:after{content:'—';margin:0 12px;color:var(--yellow)}footer{background:#14213a;color:white;padding:56px 0 22px}.footer-row{display:grid;grid-template-columns:1.2fr 1fr;gap:50px;padding-bottom:35px}.footer-row p{max-width:390px;color:#bdc9dc;font-size:.9rem}.footer-links{display:flex;justify-content:flex-end;align-content:start;gap:16px 25px;flex-wrap:wrap;color:#d0daea;font-size:.86rem}.footer-links a:hover{color:var(--yellow)}.copyright{border-top:1px solid #ffffff20;padding-top:18px;display:flex;justify-content:space-between;gap:20px;color:#aebbd0;font-size:.75rem}.article{max-width:860px;margin:auto}.article-head{padding:30px 0 18px}.article h1{font-family:var(--serif);font-size:clamp(2.7rem,6vw,5rem);font-weight:600;line-height:1.02;letter-spacing:-.05em;margin:18px 0}.article-cover{width:100%;max-height:580px;border-radius:2px;margin:30px 0;object-fit:cover}.prose{font-size:1.06rem;line-height:1.9}.prose h2{font-family:var(--serif);font-size:2rem;line-height:1.2;margin:40px 0 12px}.prose p{margin:0 0 20px}.prose ul{padding-left:24px;margin-bottom:22px}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}.gallery img{width:100%;height:200px;border-radius:2px}.archive-hero{padding:76px 0 48px;background:var(--pale);border-bottom:1px solid var(--line)}.archive-hero h1{font-family:var(--serif);font-size:clamp(3rem,6vw,5.6rem);font-weight:600;line-height:1;letter-spacing:-.05em;margin:18px 0}.archive-hero p{max-width:650px;color:var(--muted);font-size:1.05rem}.archive-tools{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px}.archive-tools input,.archive-tools select{min-height:48px;padding:11px 14px;border:1px solid #d7e1f1;border-radius:2px;background:white;color:var(--ink);font:inherit}.archive-tools input{flex:1;min-width:220px}.empty{padding:28px;border:1px dashed #b7c9e8;color:var(--muted);background:#fbfdff}.event-card[hidden]{display:none}.article-back{display:inline-flex;align-items:center;gap:9px;color:var(--blue);font-size:.84rem;font-weight:750}.article-back:hover{text-decoration:underline}.article .muted{font-size:.88rem}.skip-link{position:absolute;left:12px;top:-60px;z-index:100;background:var(--yellow);padding:10px 14px;color:var(--ink)}.skip-link:focus{top:12px}:focus-visible{outline:3px solid var(--soft);outline-offset:3px}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}@media(max-width:900px){.hero-grid{grid-template-columns:1fr 0.85fr;gap:30px}.hero h1{font-size:clamp(3rem,6.5vw,4.5rem)}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.intro-section{grid-template-columns:1fr;gap:16px}.impact-band-inner{align-items:flex-start;flex-direction:column}.nav-links{gap:13px}.footer-row{grid-template-columns:1fr}.footer-links{justify-content:flex-start}}@media(max-width:650px){.container{width:min(100% - 34px,1240px)}.hero-carousel-wide .hero-slide{height:clamp(280px,72vw,440px);max-height:none}.hero-carousel-wide .hero-slide .image-note{right:12px;bottom:70px;max-width:58%;padding:10px 12px;font-size:.9rem}.hero-carousel-wide .hero-carousel-controls{right:12px;bottom:12px;gap:7px;padding:5px}.hero-carousel-wide .hero-arrow,.hero-carousel-wide .hero-pause{width:34px;height:34px}.hero-copy-below{width:calc(100% - 28px);margin-top:22px;padding:28px 20px;border-radius:22px}.hero-copy-below:before{left:20px}.hero-copy-below h1{font-size:clamp(2.6rem,11vw,4rem)}.nav-inner{min-height:auto;align-items:flex-start;flex-direction:column;padding:13px 0 15px;gap:13px}.nav-links{width:100%;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:.78rem}.nav-links .btn{padding:8px 11px}.brand-mark{width:37px;height:37px}.hero{padding:55px 0 45px}.hero-grid{grid-template-columns:1fr;gap:35px}.hero h1{font-size:clamp(3rem,14vw,4.6rem)}.hero-img-wrap{padding-left:15px}.hero-img{height:300px}.image-note{right:-3px;max-width:165px;padding:13px 15px;font-size:.95rem}.hero-meta{margin-top:25px}.section-topline{align-items:flex-start;flex-direction:column}.heading{margin-bottom:28px}.grid{grid-template-columns:1fr;gap:18px}.card img{height:230px}.carousel{grid-auto-columns:minmax(260px,86%)}.cta{padding:70px 0}.footer-row{gap:25px}.copyright{flex-direction:column;gap:5px}.gallery{grid-template-columns:1fr 1fr}.gallery img{height:145px}.archive-hero{padding:55px 0 36px}.archive-tools input,.archive-tools select{width:100%}.article h1{font-size:clamp(2.6rem,12vw,4rem)}}
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="navbar"><div class="container nav-inner">
    <a class="brand" href="/" aria-label="Janata Pratisthan home"><img class="brand-logo" src="/uploads/janata-logo.png" alt="Janata Pratisthan — अत्त दीप भव" /></a>
    <nav class="nav-links" aria-label="Main navigation"><a href="/#about">Our story</a><a href="/#events">Events</a><a href="/events/">Journal</a><a class="btn" href="/#support">Support us <span aria-hidden="true">↗</span></a></nav>
  </div></header>
  <slot />
  <footer><div class="container"><div class="footer-row"><div><a class="brand" href="/" aria-label="Janata Pratisthan home"><img class="brand-logo" src="/uploads/janata-logo.png" alt="Janata Pratisthan — अत्त दीप भव" loading="lazy" /></a><p>A place for community stories, shared milestones, and the people who make progress possible.</p></div><div class="footer-links"><a href="/#about">Our story</a><a href="/events/">Events &amp; journal</a><a href="/#support">Support</a><a href="/events/">Explore stories</a></div></div><div class="copyright"><span>© {new Date().getFullYear()} Janata Pratisthan. All rights reserved.</span><span>Built around people. Designed for impact.</span></div></div></footer>
</body>
</html>
