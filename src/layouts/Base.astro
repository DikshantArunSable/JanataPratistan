---
const { title = 'Janata Pratisthan', description = 'People first. Progress together.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#2373F4" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style is:global>
    :root{--blue:#2373F4;--soft:#578EF5;--cyan:#65D0F4;--yellow:#F2F7A0;--ink:#17243A;--muted:#647187;--pale:#F4F8FF;--line:#E5ECF7;--radius:18px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;font-family:Inter,"Segoe UI",Arial,sans-serif;color:var(--ink);line-height:1.7}a{color:inherit;text-decoration:none}img{display:block;max-width:100%;object-fit:cover}.container{width:min(1160px,90%);margin:auto}.section{padding:78px 0}.eyebrow{color:var(--blue);font-size:.78rem;font-weight:800;letter-spacing:2px;text-transform:uppercase}.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 20px;border-radius:9px;background:var(--blue);color:white;font-weight:750}.btn:hover{background:#155bd0}.btn-yellow{background:var(--yellow);color:var(--ink)}.btn-yellow:hover{background:#e6ed85}.navbar{position:sticky;top:0;z-index:10;background:#ffffffef;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.nav-inner{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:11px;font-weight:850;font-size:1.1rem}.brand-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--blue);color:white;font-size:1.4rem}.nav-links{display:flex;align-items:center;gap:25px;font-size:.92rem;font-weight:650}.nav-links a:hover{color:var(--blue)}.hero{padding:82px 0;background:linear-gradient(125deg,#f4f8ff,#e8f3ff 62%,#d9f5ff)}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:48px}.hero h1{font-size:clamp(2.7rem,5.5vw,4.7rem);line-height:1.08;letter-spacing:-2.5px;margin:15px 0 20px}.hero h1 span{color:var(--blue)}.hero p{color:#506078;max-width:590px}.hero-img{height:410px;width:100%;border-radius:24px;box-shadow:0 22px 60px #2373f426}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}.heading{max-width:700px;margin-bottom:35px}.heading h2{font-size:clamp(2rem,4vw,3rem);line-height:1.15;letter-spacing:-1.3px;margin:10px 0}.heading p,.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:white;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-4px);box-shadow:0 14px 35px #2373f414}.card img{width:100%;height:210px}.card-content{padding:22px}.tag{display:inline-block;color:var(--blue);background:#e8efff;padding:4px 10px;border-radius:30px;font-size:.75rem;font-weight:800}.card h3{font-size:1.25rem;line-height:1.3;margin:12px 0 8px}.card p{color:var(--muted);font-size:.93rem}.meta{color:#8490a2;font-size:.8rem}.read{color:var(--blue);font-weight:750}.carousel-wrap{position:relative}.carousel{display:grid;grid-auto-columns:minmax(260px,1fr);grid-auto-flow:column;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding:3px 3px 18px}.carousel .card{scroll-snap-align:start}.carousel-controls{display:flex;gap:8px}.carousel-controls button{border:1px solid var(--line);background:white;border-radius:50%;width:42px;height:42px;cursor:pointer;color:var(--blue);font-size:1.2rem}.split{background:var(--pale)}.cta{background:var(--blue);color:white;text-align:center;padding:70px 0}.cta h2{font-size:clamp(2rem,5vw,3.3rem);line-height:1.15;max-width:760px;margin:15px auto}.cta p{max-width:650px;margin:0 auto 25px;color:#eaf2ff}.cta .eyebrow{color:var(--yellow)}footer{background:#14264a;color:white;padding:38px 0 18px}.footer-row{display:flex;justify-content:space-between;gap:30px;padding-bottom:25px}.footer-row p{max-width:350px;color:#c1cee6}.footer-links{display:flex;gap:18px;flex-wrap:wrap;color:#c1cee6}.copyright{border-top:1px solid #ffffff26;padding-top:18px;text-align:center;color:#c1cee6;font-size:.82rem}.article{max-width:850px;margin:auto}.article h1{font-size:clamp(2.3rem,5vw,4rem);line-height:1.12;letter-spacing:-1.8px;margin:15px 0}.article-cover{width:100%;max-height:500px;border-radius:20px;margin:28px 0;object-fit:cover}.prose{font-size:1.05rem}.prose h2{margin:35px 0 12px}.prose p{margin:0 0 18px}.prose ul{padding-left:24px;margin-bottom:20px}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}.gallery img{width:100%;height:190px;border-radius:12px}.archive-tools{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px}.archive-tools input,.archive-tools select{padding:12px 14px;border:1px solid var(--line);border-radius:9px;background:white;font:inherit}.empty{padding:28px;border:1px dashed #b7c9e8;border-radius:12px;color:var(--muted)}@media(max-width:850px){.hero-grid{grid-template-columns:1fr}.hero-img{height:340px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.nav-links{gap:13px}.gallery{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.section{padding:58px 0}.nav-inner{align-items:flex-start;flex-direction:column;padding:13px 0}.nav-links{width:100%;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:.82rem}.nav-links .btn{padding:8px 12px}.hero{padding:60px 0}.hero h1{letter-spacing:-1.5px}.hero-img{height:280px}.grid{grid-template-columns:1fr}.card img{height:225px}.carousel{grid-auto-columns:85%}.footer-row{flex-direction:column}.gallery{grid-template-columns:1fr 1fr}.gallery img{height:145px}}
  </style>
</head>
<body>
  <header class="navbar"><div class="container nav-inner">
    <a class="brand" href="/"><span class="brand-mark">✳</span> Janata Pratisthan</a>
    <nav class="nav-links" aria-label="Main navigation"><a href="/#about">About</a><a href="/#events">Events</a><a href="/events/">Blog &amp; Archive</a><a class="btn" href="/#donate">Donate ↗</a></nav>
  </div></header>
  <slot />
  <footer><div class="container"><div class="footer-row"><div><a class="brand" href="/"><span class="brand-mark">✳</span> Janata Pratisthan</a><p>People first. Progress together. Sharing community stories, milestones, and the work that brings us together.</p></div><div class="footer-links"><a href="/#about">About</a><a href="/events/">Events &amp; Blog</a><a href="/#donate">Donate</a><a href="mailto:contact@example.org">Contact</a></div></div><div class="copyright">© {new Date().getFullYear()} Janata Pratisthan. All rights reserved.</div></div></footer>
</body>
</html>
